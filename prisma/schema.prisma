generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PerfilUsuario {
  SOLICITANTE
  TECNICO
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  RESOLVIDO
  FECHADO
  CANCELADO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(191)
  senhaHash    String        @db.VarChar(255)
  perfil       PerfilUsuario @default(SOLICITANTE)
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  chamadosAbertos  Chamado[]          @relation("ChamadoSolicitante")
  chamadosAtendidos Chamado[]         @relation("ChamadoTecnico")
  comentarios      Comentario[]
  historicos       HistoricoChamado[]
}

model TipoProblema {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(100)
  descricao String?   @db.Text
  ativo     Boolean   @default(true)
  criadoEm  DateTime  @default(now())

  chamados Chamado[]
}

model Chamado {
  id                 Int               @id @default(autoincrement())
  titulo             String            @db.VarChar(100)
  descricao          String            @db.Text
  status             StatusChamado     @default(ABERTO)
  prioridade         PrioridadeChamado @default(MEDIA)
  solicitanteId      Int
  tecnicoId          Int?
  tipoProblemaId     Int
  motivoCancelamento String?           @db.Text
  criadoEm           DateTime          @default(now())
  atualizadoEm       DateTime          @updatedAt
  resolvidoEm        DateTime?
  fechadoEm          DateTime?

  solicitante  Usuario            @relation("ChamadoSolicitante", fields: [solicitanteId], references: [id])
  tecnico      Usuario?           @relation("ChamadoTecnico", fields: [tecnicoId], references: [id])
  tipoProblema TipoProblema       @relation(fields: [tipoProblemaId], references: [id])
  comentarios  Comentario[]
  historicos   HistoricoChamado[]

  @@index([status])
  @@index([prioridade])
  @@index([criadoEm])
  @@index([tecnicoId, status])
  @@index([solicitanteId])
  @@index([tipoProblemaId])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  conteudo  String   @db.Text
  chamadoId Int
  autorId   Int
  criadoEm  DateTime @default(now())

  chamado Chamado @relation(fields: [chamadoId], references: [id])
  autor   Usuario @relation(fields: [autorId], references: [id])

  @@index([chamadoId, criadoEm])
  @@index([autorId])
}

model HistoricoChamado {
  id        Int      @id @default(autoincrement())
  acao      String   @db.VarChar(100)
  detalhes  String?  @db.Text
  chamadoId Int
  usuarioId Int?
  criadoEm  DateTime @default(now())

  chamado Chamado  @relation(fields: [chamadoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([chamadoId, criadoEm])
  @@index([usuarioId])
}
